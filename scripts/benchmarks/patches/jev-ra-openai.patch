+++ b/jev_ra/decide/openai_decisions.py
@@ -0,0 +1,96 @@
+"""Translate jev-ra questions and answers to the OpenAI Decisions API contract."""
+
+import json
+
+from ..errors import ConfigError, JevBadResponse
+
+
+def _text(value):
+    return value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
+
+
+def build(model, state, questions):
+    """Build a named OpenAI question list without dropping offered choices."""
+    if not 1 <= len(questions) <= 400:
+        raise ConfigError(
+            "OpenAI Decisions accepts between 1 and 400 questions.", next_step="Reduce the question count."
+        )
+    output = []
+    for name, question in questions.items():
+        kind = question.get("type")
+        criteria = question.get("criteria")
+        if not isinstance(name, str) or not isinstance(criteria, dict):
+            raise ConfigError("Invalid decision question name or criteria.", next_step="Check the question set.")
+        instructions = _text(question["instructions"])
+        if kind == "choice":
+            if not 2 <= len(criteria) <= 255 or not all(isinstance(key, str) for key in criteria):
+                raise ConfigError(
+                    f"{name}: OpenAI Decisions requires 2-255 distinct string choices.",
+                    next_step="Reduce the choice count without dropping options silently.",
+                )
+            output.append(
+                {
+                    "name": name,
+                    "type": "choice",
+                    "instructions": instructions,
+                    "choices": [{"value": key, "description": _text(value)} for key, value in criteria.items()],
+                }
+            )
+        elif kind == "noul":
+            if set(criteria) != {"true", "false"}:
+                raise ConfigError(f"{name}: noul needs true and false criteria.", next_step="Check the question set.")
+            output.append(
+                {
+                    "name": name,
+                    "type": "predicate",
+                    "instructions": (
+                        f"{instructions}\nTrue: {_text(criteria['true'])}\nFalse: {_text(criteria['false'])}"
+                    ),
+                }
+            )
+        else:
+            raise ConfigError(f"{name}: unsupported decision question type.", next_step="Check the question set.")
+    return {"model": model, "input": _text(state), "questions": output}
+
+
+def read(payload, questions):
+    """Map named answers to jev-ra's format and fail closed on malformed replies."""
+    if not isinstance(payload, dict) or not isinstance(payload.get("answers"), list):
+        raise JevBadResponse("OpenAI response carries no answer list")
+    answers = {}
+    for item in payload["answers"]:
+        if not isinstance(item, dict):
+            raise JevBadResponse("OpenAI returned a malformed answer")
+        name = item.get("name")
+        if not isinstance(name, str) or name not in questions or name in answers:
+            raise JevBadResponse("OpenAI returned an unknown or duplicate answer name")
+        kind = item.get("type")
+        if kind == "refusal":
+            raise JevBadResponse(f"{name}: OpenAI declined the decision")
+        question_type = questions[name].get("type")
+        if question_type == "choice" and kind == "choice":
+            if not isinstance(item.get("choice"), str):
+                raise JevBadResponse(f"{name}: malformed choice value")
+            probabilities = item.get("probabilities")
+            if not isinstance(probabilities, list):
+                raise JevBadResponse(f"{name}: missing choice probabilities")
+            mapped = {}
+            for entry in probabilities:
+                if not isinstance(entry, dict) or not isinstance(entry.get("value"), str):
+                    raise JevBadResponse(f"{name}: malformed choice probability")
+                value = entry["value"]
+                if value in mapped:
+                    raise JevBadResponse(f"{name}: duplicate choice probability")
+                mapped[value] = entry.get("probability")
+            answers[name] = {
+                "choice": item.get("choice"),
+                "confidence": item.get("confidence"),
+                "probabilities": mapped,
+            }
+        elif question_type == "noul" and kind == "predicate":
+            answers[name] = {"noul": item.get("probability")}
+        else:
+            raise JevBadResponse(f"{name}: unexpected OpenAI answer type")
+    if set(answers) != set(questions):
+        raise JevBadResponse("OpenAI response is missing answers")
+    return {**payload, "answers": answers}
